# Farm One Frontend — Environment Variables
# Copy to .env and adjust as needed

# App display name
VITE_APP_NAME="Farm One"

# --- main branch: live API calls to FastAPI backend ---
VITE_MOCK_MODE=false
VITE_API_BASE_URL=http://localhost:8000

# --- mock-only branch: no backend required ---
# All API endpoint files return static mock data, VITE_API_BASE_URL is unused.
# VITE_MOCK_MODE=true
